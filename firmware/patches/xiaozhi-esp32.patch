+
+void AfeAudioEngine::EmitFrame(std::vector<int16_t>&& frame, bool speech) {
+#if CONFIG_NB3_BARGE_IN_GATE
+    if (barge_in_ != nullptr) {
+        barge_in_->Process(std::move(frame), speech, output_callback_);
+        return;
+    }
+#endif
+    (void)speech;
+    output_callback_(std::move(frame));
+}
