+void AudioService::CapturePreroll() {
+    std::vector<int16_t> data;
+    if (!ReadAudioData(data, 16000, 160)) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+        return;
+    }
+    if (preroll_storage_ == nullptr) {
+        const size_t capacity = (size_t)16 * AS_PREROLL_MS * codec_->input_channels();
+        preroll_storage_ = (int16_t*)heap_caps_malloc(capacity * sizeof(int16_t),
+                                                      MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (preroll_storage_ == nullptr) {
+            ESP_LOGW(TAG, "No PSRAM for the pre-roll ring; the sentence start is not kept");
+        }
+        nb_pcm_ring_init(&preroll_ring_, preroll_storage_, capacity);
+    }
+    nb_pcm_ring_push(&preroll_ring_, data.data(), data.size());
+}
+
+void AudioService::DrainPreroll() {
+    // The engine discards what is fed before the AFE finishes its pending
+    // reset on re-activation; give its task a moment to apply it.
+    vTaskDelay(pdMS_TO_TICKS(20));
+
+    const size_t chunk = (size_t)160 * codec_->input_channels();
+    const size_t total = nb_pcm_ring_count(&preroll_ring_) / codec_->input_channels();
+    const size_t frame_samples = chunk * OPUS_FRAME_DURATION_MS / 10;
+    size_t since_pause = 0;
+    std::vector<int16_t> data(chunk);
+    size_t n;
+    while (!service_stopped_.load() &&
+           (n = nb_pcm_ring_pop(&preroll_ring_, data.data(), chunk)) > 0) {
+        std::vector<int16_t> piece(data.begin(), data.begin() + n);
+        audio_engine_->Feed(std::move(piece));
+        since_pause += n;
+        if (since_pause < frame_samples) {
+            continue;
+        }
+        since_pause = 0;
+        // The encode queue drops its oldest frame when full; feed no faster
+        // than the encoder drains it.
+        for (int i = 0; i < 40; ++i) {
+            {
+                std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+                if (audio_encode_queue_.size() < MAX_ENCODE_TASKS_IN_QUEUE / 2 + 1) break;
+            }
+            vTaskDelay(pdMS_TO_TICKS(5));
+        }
+    }
+    nb_pcm_ring_clear(&preroll_ring_);
+    ESP_LOGI(TAG, "Replayed %u ms of pre-roll", (unsigned)(total * 1000 / 16000));
+}
