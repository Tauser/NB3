diff --git a/main/Kconfig.projbuild b/main/Kconfig.projbuild
index 6a7c0fb..fdc22be 100644
--- a/main/Kconfig.projbuild
+++ b/main/Kconfig.projbuild
@@ -6,6 +6,14 @@ config OTA_URL
     help
         The application will access this URL to check for new firmwares and server address.
 
+config FIRMWARE_AUTO_UPGRADE
+    bool "Install firmware updates offered by the OTA server"
+    default y
+    help
+        Turn off on devices that run their own firmware on top of xiaozhi, so
+        an update offered by the server cannot replace it. The OTA check still
+        runs for activation and server configuration.
+
 choice
     prompt "Flash Assets"
     default FLASH_DEFAULT_ASSETS if !USE_EMOTE_MESSAGE_STYLE
@@ -173,6 +181,9 @@ choice BOARD_TYPE
     config BOARD_TYPE_BREAD_COMPACT_WIFI
         bool "Bread Compact Wi-Fi (面包板)"
         depends on IDF_TARGET_ESP32S3
+    config BOARD_TYPE_NOISEBOT_V3
