diff --git a/main/CMakeLists.txt b/main/CMakeLists.txt
index 633ef85..535532d 100644
--- a/main/CMakeLists.txt
+++ b/main/CMakeLists.txt
@@ -91,7 +91,16 @@ set(EMOTE_RESOLUTION "320_240")
 
 # Select the board source directory from Kconfig
 # Set default assets if the board uses partition table V2
-if(CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI)
+# Out-of-tree boards override BOARD_ROOT to point at their own directory.
+set(BOARD_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/boards")
+if(CONFIG_BOARD_TYPE_NOISEBOT_V3)
+    # The NoiseBot v3 board lives in the parent firmware tree (firmware/boards).
+    set(BOARD_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../boards")
+    set(BOARD_DIR "noisebot-v3")
+    set(BUILTIN_TEXT_FONT font_noto_sans_basic_16_4)
+    set(BUILTIN_ICON_FONT font_material_symbols_16_4)
+    set(DEFAULT_EMOJI_COLLECTION noto-color-emoji_32)
+elseif(CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI)
     set(BOARD_DIR "bread-compact-wifi")
     set(BUILTIN_TEXT_FONT font_noto_sans_basic_14_1)
     set(BUILTIN_ICON_FONT font_material_symbols_14_1)
@@ -899,7 +908,7 @@ if(NOT BOARD_DIR AND NOT CMAKE_BUILD_EARLY_EXPANSION)
     message(FATAL_ERROR "The selected board does not define BOARD_DIR")
 endif()
 
-set(BOARD_CONFIG_FILE "${CMAKE_CURRENT_SOURCE_DIR}/boards/${BOARD_DIR}/config.json")
+set(BOARD_CONFIG_FILE "${BOARD_ROOT}/${BOARD_DIR}/config.json")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${BOARD_CONFIG_FILE}")
 
 # BOARD_TYPE and BOARD_MANUFACTURER are reported by the firmware.
@@ -930,8 +939,8 @@ if(NOT CMAKE_BUILD_EARLY_EXPANSION AND NOT BOARD_TYPE MATCHES "^[a-z0-9.-]+$")
 endif()
 
 file(GLOB BOARD_SOURCES
-    ${CMAKE_CURRENT_SOURCE_DIR}/boards/${BOARD_DIR}/*.cc
-    ${CMAKE_CURRENT_SOURCE_DIR}/boards/${BOARD_DIR}/*.c
+    ${BOARD_ROOT}/${BOARD_DIR}/*.cc
+    ${BOARD_ROOT}/${BOARD_DIR}/*.c
 )
 list(APPEND SOURCES ${BOARD_SOURCES})
 
diff --git a/main/Kconfig.projbuild b/main/Kconfig.projbuild
index 6a7c0fb..5171d79 100644
--- a/main/Kconfig.projbuild
+++ b/main/Kconfig.projbuild
@@ -173,6 +173,9 @@ choice BOARD_TYPE
     config BOARD_TYPE_BREAD_COMPACT_WIFI
         bool "Bread Compact Wi-Fi (面包板)"
         depends on IDF_TARGET_ESP32S3
+    config BOARD_TYPE_NOISEBOT_V3
+        bool "NoiseBot v3"
+        depends on IDF_TARGET_ESP32S3
     config BOARD_TYPE_BREAD_COMPACT_WIFI_LCD
         bool "Bread Compact Wi-Fi + LCD (面包板)"
         depends on IDF_TARGET_ESP32S3
