# NoiseBot v3 overrides, layered after xiaozhi's sdkconfig.defaults(.esp32s3).

CONFIG_BOARD_TYPE_NOISEBOT_V3=y
CONFIG_LANGUAGE_PT_BR=y

# NB3 is not stock xiaozhi: an update offered by the OTA server would replace
# the whole robot firmware. The OTA check still runs for activation.
CONFIG_FIRMWARE_AUTO_UPGRADE=n

# Wake word: "Jarvis" is pronounceable for PT-BR speakers; the upstream
# default (Nihao Xiaozhi) is disabled because esp-sr can load several at once.
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_SR_WN_WN9_JARVIS_TTS=y

# Device-side AEC, so the user can talk over the robot: the board feeds the
# AFE a speaker reference built from the I2S DMA (no codec loopback here),
# and xiaozhi switches to realtime listening, where the server stops talking
# when it hears the user.
CONFIG_USE_DEVICE_AEC=y

# Neural voice detector (VADNet) instead of WebRTC's: it tells speech from
# knocks, fans and music far better, and while the robot speaks only what it
# calls speech may reach the server and interrupt (NB3_BARGE_IN_GATE).
CONFIG_SR_VADN_VADNET1_MEDIUM=y

# A crash prints a core dump of both cores on the console before rebooting:
# a backtrace alone does not say what the other core was holding. The flash
# has no room for a core dump partition inside the first 16 MB.
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y

# N32R16V: 32 MB octal flash. The partition table stays inside the first
# 16 MB so the bootloader needs no experimental 32-bit addressing.
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=n
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="xiaozhi-esp32/partitions/v2/16m.csv"
