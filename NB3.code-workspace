{
    "folders": [
        {
            "name": "NB3",
            "path": "."
        },
        {
            "name": "firmware (etapa 0: xiaozhi + board NB3)",
            "path": "firmware/xiaozhi-esp32"
        }
    ],
    "settings": {
        "idf.currentSetup": "C:\\esp\\v6.1\\esp-idf",
        "idf.port": "COM5",
        "idf.monitorPort": "COM5",
        "idf.flashType": "UART",
        "idf.flashBaudRate": "460800",
        "idf.monitorBaudRate": "115200",
        "idf.sdkconfigDefaults": [
            "sdkconfig.defaults",
            "../sdkconfig.nb3.defaults"
        ],
        "idf.customExtraVars": {
            "IDF_TARGET": "esp32s3",
            "ESP_IDF_VERSION": "6.1"
        },
        "idf.openOcdConfigs": [
            "board/esp32s3-builtin.cfg"
        ],
        "files.exclude": {
            "firmware/xiaozhi-esp32": true
        },
        "search.exclude": {
            "**/build": true,
            "**/managed_components": true
        },
        "files.associations": {
            "sdkconfig*.defaults": "properties"
        }
    },
    "extensions": {
        "recommendations": [
            "espressif.esp-idf-extension"
        ]
    }
}
